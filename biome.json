{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tools/**",
      "scripts/**",
      "!tools/postmortem/cluster-model.json",
      "!**/node_modules/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noLabelWithoutControl": "off",
        "noSvgWithoutTitle": "off",
        "noAutofocus": "off"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noUnknownAtRules": "off",
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/main/session-manager.ts",
        "src/main/console-service.ts",
        "src/main/activity-watcher.ts",
        "src/main/claude-watcher.ts",
        "src/main/change-feed-service.ts",
        "src/main/task-service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "Only the window side imports Electron. A service reaches the window through event-sink.ts."
                },
                "patterns": [
                  {
                    "group": ["./main", "./main.ts", "./ipc-handlers*", "./notification-service*", "./slack-service*"],
                    "message": "Only the window side imports the window side."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/main/main.ts",
        "src/main/ipc-handlers.ts",
        "src/main/notification-service.ts",
        "src/main/slack-service.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
